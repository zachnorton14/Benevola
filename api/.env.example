# Copy this file to api/.env and fill in the values.
#   cp api/.env.example api/.env
# api/.env is gitignored — never commit real secrets.

NODE_ENV=development

# The server listens on BE_PORT. FE_PORT and DOMAIN together build the CORS
# origin (`${DOMAIN}:${FE_PORT}`), which must match where the frontend runs,
# or the browser will drop the session cookie on every API call.
BE_PORT=5173
FE_PORT=3000
DOMAIN=http://localhost

# Required — express-session refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# ── Database ─────────────────────────────────────────────────────────
# Development uses SQLite at api/data/dev.sqlite; nothing to configure and
# nothing to install. Optional override:
# SQLITE_STORAGE_DEV=
#
# Production (NODE_ENV=production) uses Postgres and REQUIRES this. Use the
# *pooled* Neon connection string — the host with "-pooler" in it — because
# serverless opens many short-lived connections and the pooler is what keeps
# that from exhausting the database's connection limit.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Sessions ─────────────────────────────────────────────────────────
# Stored in the database, in the "Sessions" table created by
# migrations/20260820000000-create-sessions.js. There is no Redis any more, so
# there is nothing to install locally and nothing extra to pay for.

# ── Cookies and CORS ─────────────────────────────────────────────────
# Only needed when the frontend is NOT proxying /api through its own domain.
# In the deployment described in DEPLOY.md it proxies, requests are
# same-origin, and both of these can stay unset.
#
# CORS_ORIGIN accepts a comma-separated list of allowed origins.
# CORS_ORIGIN=https://your-frontend.vercel.app
#
# Set COOKIE_SAMESITE=none ONLY if the browser talks to the API on a different
# domain than the frontend. A "lax" cookie is not sent on cross-site fetch, so
# leaving this alone in that setup means every request looks logged out.
# COOKIE_SAMESITE=none

# ── Image uploads (Cloudflare R2) ────────────────────────────────────
# Optional: leave blank and the app runs normally, but the upload buttons stay
# hidden and image fields are URL-only. All five must be set to switch on.
#
#   R2_ACCOUNT_ID       Cloudflare dashboard -> R2 -> "Account ID"
#   R2_BUCKET           the bucket name you created, e.g. benevola-uploads
#   R2_ACCESS_KEY_ID    R2 -> API -> Manage API Tokens -> Object Read & Write
#   R2_SECRET_ACCESS_KEY  shown once when the token is created
#   R2_PUBLIC_URL       public base URL for the bucket, no trailing slash.
#                       Either the r2.dev dev domain (fine for coursework) or
#                       a custom domain (needed for production traffic).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Optional — only needed if the Google sign-in route in src/routes/auth.js
# is uncommented.
# GOOGLE_CLIENT_ID=
